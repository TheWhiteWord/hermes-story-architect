+.panel-edit.on { display: inline-block; }
+.panel-edit:hover { color: var(--accent); border-color: var(--accent); }
+
+.ef-menu { position: fixed; z-index: 45; min-width: 230px; max-height: 60vh; overflow-y: auto; padding: 4px;
+  background: var(--panel-bg); border: 1px solid var(--border); border-radius: var(--radius);
+  box-shadow: 0 10px 30px color-mix(in srgb, #000 45%, transparent); }
+.ef-menu button { display: flex; flex-direction: column; align-items: flex-start; width: 100%; text-align: left; gap: 0;
+  background: none; border: none; color: var(--foreground); font: inherit; font-size: var(--font-size-sm);
+  padding: 5px 8px; border-radius: 4px; cursor: pointer; }
+.ef-menu button:hover { background: var(--card); }
