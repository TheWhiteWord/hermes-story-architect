+/* ─── Entity form overlay ─────────────────────────────────────────────────
+   Same family as the Memory dialog: its backdrop, surface, border and radius.
+   Only theme tokens are used, so it follows the host. */
+
+.ef-backdrop {
+  display: none; position: fixed; inset: 0; z-index: 40;
+  align-items: center; justify-content: center; padding: 16px;
+  background: color-mix(in srgb, var(--foreground) 22%, transparent);
+}
+.ef-backdrop.open { display: flex; }
+
+.ef-card {
+  width: min(660px, 100%); height: min(740px, 92vh);
+  display: flex; flex-direction: column; overflow: hidden;
+  border: 1px solid var(--border); border-radius: var(--radius);
+  background: var(--panel-bg); color: var(--foreground);
+  box-shadow: 0 16px 48px color-mix(in srgb, #000 45%, transparent);
+}
+
+/* header */
+.ef-head { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px 10px; flex-shrink: 0; }
+.ef-titles { flex: 1; min-width: 0; }
+.ef-kicker { font-size: var(--font-size-xs); letter-spacing: .08em; text-transform: uppercase; color: var(--muted-foreground); }
+.ef-name { font-size: var(--font-size-lg); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.ef-name.empty { color: var(--muted-foreground); font-weight: 400; }
+.ef-id { font-size: var(--font-size-xs); color: var(--muted-foreground); margin-top: 1px; min-height: 15px; }
+.ef-x-close { background: none; border: 1px solid var(--border); border-radius: var(--radius); color: var(--muted-foreground);
+  width: 24px; height: 24px; line-height: 1; cursor: pointer; font-size: 14px; }
+.ef-x-close:hover { color: var(--foreground); }
+
+/* tabs */
+.ef-tabs { display: flex; gap: 2px; padding: 0 16px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
+.ef-tab { position: relative; background: none; border: none; border-bottom: 2px solid transparent; margin-bottom: -1px;
+  padding: 7px 10px; font: inherit; font-size: var(--font-size-sm); color: var(--muted-foreground); cursor: pointer; }
+.ef-tab:hover { color: var(--foreground); }
+.ef-tab.active { color: var(--foreground); border-bottom-color: var(--accent); }
+.ef-tab small { color: var(--muted-foreground); margin-left: 4px; font-size: var(--font-size-xs); }
