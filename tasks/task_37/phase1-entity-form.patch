+.ef-row .ef-input { flex: 1; }
+.ef-rm { width: 26px; flex-shrink: 0; background: none; border: 1px solid var(--border); border-radius: var(--radius);
+  color: var(--muted-foreground); cursor: pointer; font-size: 14px; line-height: 1; }
+.ef-rm:hover { color: var(--role-antagonist); border-color: var(--role-antagonist); }
+.ef-add { align-self: flex-start; background: none; border: 1px dashed var(--border); border-radius: var(--radius);
+  color: var(--muted-foreground); font: inherit; font-size: var(--font-size-xs); padding: 3px 10px; cursor: pointer; }
+.ef-add:hover { color: var(--accent); border-color: var(--accent); }
+
+/* derived (read-only) */
