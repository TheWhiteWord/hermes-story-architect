+.ef-impact li { margin: 3px 0; }
+.ef-impact .block li { color: var(--role-antagonist); }
+
+/* footer */
+.ef-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); flex-shrink: 0; }
+.ef-foot .grow { flex: 1; font-size: var(--font-size-sm); color: var(--muted-foreground); }
+.ef-foot .btn { padding: 5px 14px; font-size: var(--font-size-sm); }
+.ef-foot .btn[disabled] { opacity: .45; cursor: not-allowed; }
+.btn-danger { color: var(--role-antagonist); border-color: color-mix(in srgb, var(--role-antagonist) 40%, transparent); }
+.btn-danger:hover { background: color-mix(in srgb, var(--role-antagonist) 12%, transparent); color: var(--role-antagonist); }
+.btn-ghost { background: none; border-color: transparent; }
+
+/* toast */
+.ef-toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 60; padding: 8px 14px;
+  border-radius: var(--radius); background: var(--panel-bg); border: 1px solid var(--border); color: var(--foreground);
+  font-size: var(--font-size-sm); box-shadow: 0 8px 24px color-mix(in srgb, #000 45%, transparent); }
+.ef-toast.bad { border-color: var(--role-antagonist); }
+
+/* entry points */
+.panel-edit { background: none; border: 1px solid var(--border); border-radius: var(--radius); color: var(--muted-foreground);
