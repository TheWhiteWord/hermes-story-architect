+.ef-ro { display: flex; flex-direction: column; gap: 3px; padding: 7px 10px; border-radius: var(--radius);
+  background: color-mix(in srgb, var(--foreground) 3%, transparent); color: var(--muted-foreground); font-size: var(--font-size-sm); }
+.ef-ro.none { font-style: italic; }
+.ef-note { font-size: var(--font-size-xs); color: var(--muted-foreground); }
+
+/* review / delete */
+.ef-sub { font-size: var(--font-size-sm); color: var(--muted-foreground); }
+.ef-diff { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
+.ef-diff-h { padding: 5px 10px; font-size: var(--font-size-sm); font-weight: 500; background: var(--card); border-bottom: 1px solid var(--border); }
+.ef-diff-b { display: grid; grid-template-columns: 1fr 1fr; }
+.ef-diff-b > div { padding: 7px 10px; font-size: var(--font-size-sm); white-space: pre-wrap; word-break: break-word; }
+.ef-diff-b .was { color: var(--muted-foreground); border-right: 1px solid var(--border); }
+.ef-diff-b .was::before, .ef-diff-b .now::before { display: block; font-size: var(--font-size-xs); letter-spacing: .08em;
+  text-transform: uppercase; margin-bottom: 2px; color: var(--muted-foreground); }
+.ef-diff-b .was::before { content: 'Before'; } .ef-diff-b .now::before { content: 'After'; }
+.ef-diff .add { color: var(--status-active); } .ef-diff .del { color: var(--role-antagonist); text-decoration: line-through; }
+
+.ef-impact { display: flex; flex-direction: column; gap: 6px; }
+.ef-impact h4 { font-size: var(--font-size-xs); letter-spacing: .08em; text-transform: uppercase; font-weight: 500; color: var(--muted-foreground); margin: 6px 0 0; }
