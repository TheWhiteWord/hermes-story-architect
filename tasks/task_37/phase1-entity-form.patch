+  position: absolute; top: 7px; right: 1px; }
+.ef-tab .ef-dot.on { display: block; }
+
+/* body */
+.ef-body { flex: 1; overflow-y: auto; padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 14px; }
+.ef-field { display: flex; flex-direction: column; gap: 4px; }
+.ef-label { font-size: var(--font-size-sm); font-weight: 500; }
+.ef-req { color: var(--accent); text-decoration: none; margin-left: 3px; }
+.ef-help { font-size: var(--font-size-xs); color: var(--muted-foreground); }
+
+.ef-input {
+  width: 100%; font: inherit; font-size: var(--font-size-base); color: var(--foreground);
+  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
+  padding: 6px 8px; line-height: 1.45;
+}
+.ef-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 22%, transparent); }
+.ef-input:disabled { opacity: .6; cursor: not-allowed; }
+.ef-input.ef-invalid { border-color: var(--role-antagonist); }
+select.ef-input { appearance: auto; }
+textarea.ef-input { resize: none; min-height: 34px; overflow: hidden; }
+.ef-area { min-height: 84px; }
+
+.ef-msg { font-size: var(--font-size-xs); min-height: 0; }
+.ef-msg.err { color: var(--role-antagonist); }
+.ef-msg.warn { color: var(--c-gap); }
+
+.ef-banner { display: none; padding: 7px 10px; border-radius: var(--radius); font-size: var(--font-size-sm);
+  border: 1px solid color-mix(in srgb, var(--role-antagonist) 45%, transparent);
+  background: color-mix(in srgb, var(--role-antagonist) 10%, transparent); }
+.ef-banner.on { display: block; }
+.ef-banner.info { border-color: color-mix(in srgb, var(--c-gap) 45%, transparent); background: color-mix(in srgb, var(--c-gap) 10%, transparent); }
+.ef-banner button { margin-left: 8px; }
+
+/* list of strings */
+.ef-list { display: flex; flex-direction: column; gap: 5px; }
