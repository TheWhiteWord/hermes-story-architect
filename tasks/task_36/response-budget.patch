+        compacted = set(result.get("detail", {}).get("compacted", []))
+        kept = [q for a in result["acts"] for q in a["sequences"]
+                if q["id"] not in compacted]
+        assert kept, "a 20000 budget should hold at least one full sequence"
+        for q in kept:
+            for s in q["scenes"]:
+                assert s == full[s["id"]]
