+      if (e.target.closest('[data-fmt]')) { S.showWarn = !S.showWarn; store.set('se.warn', S.showWarn ? '1' : '0'); renderStatus(); }
+    });
+    root.querySelector('#se-statusbar').addEventListener('change', (e) => {
