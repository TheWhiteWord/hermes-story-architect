+/* Script editor overlay. Lives inside #main so the sidebar, detail panel and chat
+   stay beside it. Tokens come from base.css; the page itself is paper. */
+#main { position: relative; }
+
+.se {
+  position: absolute; inset: 0; z-index: 6;
+  display: flex; flex-direction: column;
+  background: var(--background); color: var(--foreground);
+  --se-paper: #eeece5; --se-ink: #1b1b1b; --se-ink-soft: #6b6a64;
+  --se-warn: var(--c-gap, #e0a86b); --se-bad: var(--role-antagonist, #e07070);
+  --se-ok: var(--status-active, #6bbfb0);
+}
+.se[hidden] { display: none; }
+.se * { box-sizing: border-box; }
+.se-muted { color: var(--muted-foreground); }
+.se-small { font-size: var(--font-size-sm); }
+.se button { font: inherit; color: inherit; }
+.se button:disabled { opacity: .4; cursor: default; }
+.se .btn { padding: 6px 12px; border: 1px solid var(--border); background: var(--card);
+  border-radius: var(--radius); cursor: pointer; font-size: var(--font-size-sm); }
+.se .btn:hover:not(:disabled) { background: rgba(255,255,255,.08); }
+.se .se-primary { background: var(--accent); color: #0d1020; border-color: transparent; font-weight: 600; }
+.se .se-primary:hover:not(:disabled) { background: var(--accent); filter: brightness(1.08); }
+.se :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+/* header */
+.se-head { flex: 0 0 auto; display: flex; align-items: center; gap: 14px; padding: 10px 16px;
+  border-bottom: 1px solid var(--border); min-height: 52px; }
+.se-back { background: none; border: 1px solid var(--border); border-radius: var(--radius);
+  padding: 6px 12px; cursor: pointer; font-size: var(--font-size-sm); }
+.se-back:hover { background: rgba(255,255,255,.08); }
+.se-title { min-width: 0; flex: 1; line-height: 1.25; }
+.se-title-main { display: flex; gap: 10px; align-items: baseline; }
+.se-title-main strong { font-size: var(--font-size-lg); }
+.se-title-main span { font-size: var(--font-size-sm); }
+.se-sub { font-size: var(--font-size-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.se-head-actions { display: flex; align-items: center; gap: 10px; }
+.se-dirty { display: inline-flex; align-items: center; gap: 6px; color: var(--se-warn); font-size: var(--font-size-sm); }
+.se-dirty i { width: 7px; height: 7px; border-radius: 50%; background: var(--se-warn); }
+
+/* banner */
+.se-banner { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
+  padding: 8px 16px; font-size: var(--font-size-sm); border-bottom: 1px solid var(--border); }
+.se-banner[hidden] { display: none; }
+.se-banner span { flex: 1 1 280px; }
+.se-banner-conflict { background: rgba(224,168,107,.12); }
+.se-banner-locked { background: rgba(123,156,240,.1); }
+
+.se-body { flex: 1; min-height: 0; display: flex; }
+
+/* rail */
+.se-rail { flex: 0 0 248px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto;
+  padding: 14px 12px; border-right: 1px solid var(--border); background: var(--panel-bg, #181818); }
+.se-label { display: flex; align-items: center; justify-content: space-between; margin: 8px 4px 6px;
+  font-size: var(--font-size-xs); letter-spacing: .09em; text-transform: uppercase; color: var(--muted-foreground); }
+.se-pm { display: inline-flex; gap: 2px; }
+.se-pm button { width: 22px; height: 22px; line-height: 1; border: 1px solid var(--border); background: none;
+  border-radius: 4px; cursor: pointer; color: var(--muted-foreground); }
+.se-pm button:hover:not(:disabled) { color: var(--foreground); background: rgba(255,255,255,.08); }
+.se-els { display: flex; flex-direction: column; gap: 3px; }
+.se-el { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px;
+  background: none; border: 1px solid transparent; border-radius: var(--radius); cursor: pointer; text-align: left; }
+.se-el:hover:not(:disabled) { background: rgba(255,255,255,.06); }
