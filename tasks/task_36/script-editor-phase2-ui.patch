+  window.addEventListener('hashchange', () => DASH.routeEditor());
+  window.addEventListener('beforeunload', (e) => { if (isDirty()) { e.preventDefault(); e.returnValue = ''; } });
+
+  // ─── Event wiring ──────────────────────────────────────────────────────────
+  function wire(root) {
