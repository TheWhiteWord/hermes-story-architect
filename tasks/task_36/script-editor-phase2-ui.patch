+.se-stage { flex: 1; min-width: 0; display: flex; flex-direction: column; position: relative; }
+.se-scroll { flex: 1; min-height: 0; overflow: auto; padding: 36px 24px 60px; }
+.se-paper-wrap { width: max-content; min-width: 100%; display: flex; justify-content: center; }
+.se-paper {
+  position: relative; margin-left: 130px;   /* room for the element labels */
+  background: var(--se-paper); color: var(--se-ink);
+  font-family: 'Courier New', Courier, monospace; font-size: 13px; line-height: 1.5;
+  width: 84ch; min-height: 70vh; padding: 9ch 6ch 14ch 14ch;
+  box-shadow: 0 6px 30px rgba(0,0,0,.45); border-radius: 2px;
+}
+.se-loading { padding: 20px; color: var(--se-ink-soft); }
+.se-row { position: relative; margin-top: 1em; }
+.se-row.se-r-parenthetical, .se-row.se-r-dialogue { margin-top: 0; }
+.se-gutter { position: absolute; right: calc(100% + 16ch + 18px); top: .25em; width: 120px; text-align: right;
+  font-family: var(--font-sans, system-ui, sans-serif); font-size: var(--font-size-xs); letter-spacing: .08em;
+  text-transform: uppercase; color: var(--muted-foreground); pointer-events: none; white-space: nowrap; }
+.se-r-character .se-gutter, .se-r-parenthetical .se-gutter, .se-r-dialogue .se-gutter,
+.se-r-transition .se-gutter { right: calc(100% + 14ch + 18px); }
+/* Margins in ch, so the page keeps its proportions whatever the font size. */
+.se-r-character { margin-left: 22ch; }
+.se-r-parenthetical { margin-left: 16ch; }
+.se-r-dialogue { margin-left: 10ch; margin-right: 6ch; }
+.se-r-transition { margin-left: 30ch; }
+.se-r-character .se-gutter { right: calc(100% + 36ch + 18px); }
+.se-r-parenthetical .se-gutter { right: calc(100% + 30ch + 18px); }
+.se-r-dialogue .se-gutter { right: calc(100% + 24ch + 18px); }
