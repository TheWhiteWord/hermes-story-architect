+
+/* the scene panel's Script card */
+.se-card { border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); padding: 12px; }
+.se-card-preview { font-family: 'Courier New', Courier, monospace; font-size: 12px; line-height: 1.5;
+  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 8px; }
+.se-card-preview.se-empty { font-family: inherit; color: var(--muted-foreground); font-style: italic; }
+.se-card-meta { display: flex; justify-content: space-between; gap: 8px; min-height: 18px; margin-bottom: 10px;
+  font-size: var(--font-size-sm); color: var(--muted-foreground); }
+.se-card-fmt { color: var(--status-active, #6bbfb0); }
+.se-card-bad { color: var(--role-antagonist, #e07070); }
+.se-open-btn { width: 100%; padding: 9px; border: 0; border-radius: var(--radius); cursor: pointer; font-weight: 600;
+  background: var(--accent); color: #0d1020; font-size: var(--font-size-base); }
+.se-open-btn:hover { filter: brightness(1.08); }
+
+@media (max-width: 900px) { .se-rail { flex-basis: 200px; } }
