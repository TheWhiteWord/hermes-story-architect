+.se-ta { display: block; width: 100%; resize: none; overflow: hidden; border: 0; outline: 0;
+  background: transparent; color: inherit; font: inherit; line-height: inherit; padding: 0 2px; border-radius: 2px; }
+.se-ta:focus { background: rgba(60,80,160,.07); box-shadow: -3px 0 0 0 rgba(60,80,160,.45); }
+.se-t-character { text-transform: uppercase; }
+.se-t-transition { text-align: right; font-weight: bold; text-transform: uppercase; }
